# ── Secrets — never commit ──
.env
*.key
*service-account*.json
credentials.json
# GCP downloads a service-account key as <project>-<hash>.json, which matches none of
# the patterns above. Ignore every JSON at the repo root instead: no tracked JSON lives
# there, and a key sitting untracked-but-unignored is one `git add -A` from publication.
/*.json
*-*[0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.json
*.iam.gserviceaccount.com.json

# ── Local working state (Smartlead + HubSpot are the real sources of truth) ──
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3

# ── Human review exports (Sheets/CSVs are review surfaces, not the database) ──
reviews/*
!reviews/.gitkeep

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# ── OS / editor noise ──
.DS_Store
Thumbs.db
.vscode/
.idea/
