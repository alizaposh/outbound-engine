# ─────────────────────────────────────────────────────────────────────────────
# Outbound Engine — environment variables
#
# HOW TO USE:
#   1. Copy this file to ".env"  (cp .env.example .env)
#   2. Fill in real values.
#   3. NEVER commit ".env". It is git-ignored on purpose.
#
# Fill in what you have now (HubSpot). Add the rest as you reach each phase.
# ─────────────────────────────────────────────────────────────────────────────

# ── HubSpot (CRM — source of truth) ──────────────────────────────────────────
# Create a HubSpot Private App and copy its access token. Grant scopes for
# contacts read/write (and companies if you enrich from them).
HUBSPOT_ACCESS_TOKEN=

# ── Smartlead (sending — add after your Phase 0 go/no-go) ─────────────────────
SMARTLEAD_API_KEY=
# Optional: default sending schedule / timezone can live in config/smartlead-defaults.md

# ── Slack (campaign requests + review + approval) ────────────────────────────
# Channel decision: SLACK BRIEF. A stakeholder posts the audience + brief in Slack;
# Claude reads it, posts the review link back, and watches for approval. This needs
# a Slack bot token (read messages + post). Create a Slack app, add bot scopes
# (e.g. channels:history, chat:write), install it, and paste the bot token here.
SLACK_BOT_TOKEN=
SLACK_REQUEST_CHANNEL=     # channel where stakeholders post campaign briefs
SLACK_REVIEW_CHANNEL=      # channel where Claude posts review links / asks for approval

# ── Bulk copy LLM (the "cheap" model for message generation) ─────────────────
# Decision: Claude Haiku via the Anthropic API.
# IMPORTANT: this is SEPARATE from the login that powers Claude Code. Claude Code
# runs on your Claude subscription; the bulk-generation SCRIPT calls the Anthropic
# API directly and needs a pay-as-you-go API key from console.anthropic.com.
ANTHROPIC_API_KEY=
BULK_LLM_PROVIDER=anthropic
BULK_LLM_MODEL=claude-haiku-4-5-20251001   # current Haiku; confirm latest/pricing in the console

# ── Google Sheets (human review surface) ─────────────────────────────────────
# Path to a Google service-account JSON key file, or leave blank if you export
# plain CSVs to reviews/ instead of live Sheets.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Local database (optional working state) ──────────────────────────────────
# Default location for the SQLite working DB. Lives under data/ (git-ignored).
DATABASE_PATH=data/outbound.db
