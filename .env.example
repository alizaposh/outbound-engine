# ─────────────────────────────────────────────────────────────────────────────
# Outbound Engine — environment variables
#
# HOW TO USE:
#   1. Copy this file to ".env"  (cp .env.example .env)
#   2. Fill in real values.
#   3. NEVER commit ".env". It is git-ignored on purpose.
#
# Fill in what you have now (HubSpot). Add the rest as you reach each phase.
# ─────────────────────────────────────────────────────────────────────────────

# ── HubSpot (CRM — source of truth) ──────────────────────────────────────────
# Create a HubSpot Private App and copy its access token. Grant scopes for
# contacts read/write (and companies if you enrich from them).
HUBSPOT_ACCESS_TOKEN=

# ── Smartlead (sending — add after your Phase 0 go/no-go) ─────────────────────
SMARTLEAD_API_KEY=
# Optional: default sending schedule / timezone can live in config/smartlead-defaults.md

# ── Slack (campaign requests + review + approval) ────────────────────────────
# Channel decision: SLACK BRIEF. A stakeholder posts the audience + brief in Slack;
# Claude reads it, posts the review link back, and watches for approval. This needs
# a Slack bot token (read messages + post). Create a Slack app, add bot scopes
# (e.g. channels:history, chat:write), install it, and paste the bot token here.
SLACK_BOT_TOKEN=
SLACK_REQUEST_CHANNEL=     # channel where stakeholders post campaign briefs
SLACK_REVIEW_CHANNEL=      # channel where Claude posts review links / asks for approval
SLACK_HEARTBEAT_CHANNEL=   # channel for the scheduled-run heartbeat. Keep it
                           # SEPARATE from the review channel: the heartbeat is
                           # noisy by design (it posts on quiet runs too) and
                           # would bury approval requests. Falls back to
                           # SLACK_REVIEW_CHANNEL if unset.

# ── Bulk copy LLM (the "cheap" model for message generation) ─────────────────
# Decision: Claude Haiku via AMAZON BEDROCK (not the first-party Anthropic API).
# IMPORTANT: this is SEPARATE from the login that powers Claude Code. Claude Code
# runs on your Claude subscription; the bulk-generation SCRIPT calls Bedrock
# directly. Billing is AWS at Bedrock's rates, not Anthropic's.
#
# A Bedrock long-term API key: a base64 value starting "ABSK". Send it as a
# bearer token:  Authorization: Bearer $AWS_BEARER_TOKEN_BEDROCK
# This is the name the AWS and Anthropic SDKs auto-discover, so keep it as-is.
AWS_BEARER_TOKEN_BEDROCK=
BULK_LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
# Bedrock model IDs differ from first-party ones: they carry the "anthropic."
# provider prefix and a version suffix. The leading "us." selects the US
# cross-region inference profile, for better availability across US regions.
BULK_LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
#
# Endpoint shape (InvokeModel):
#   https://bedrock-runtime.$AWS_REGION.amazonaws.com/model/$BULK_LLM_MODEL/invoke
# The body needs "anthropic_version": "bedrock-2023-05-31" and carries no "model"
# field, since the model is already in the URL path.
#
# Prompt caching works on this path. The generation prompt is a large fixed
# rulebook (positioning + personas + message-generation) followed by a small
# per-prospect note, so cache the rulebook prefix once per batch.

# ── Google Sheets (human review surface) ─────────────────────────────────────
# Path to a Google service-account JSON key file, or leave blank if you export
# plain CSVs to reviews/ instead of live Sheets.
GOOGLE_SERVICE_ACCOUNT_JSON=
