<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>vip.posh.outbound-watchdog</string>

  <!-- Notices when the Claude Desktop heartbeat has STOPPED and says so in Slack.

       A SEPARATE plist from the intake job rather than a shell wrapper running both:
       macOS TCC does not grant /bin/bash access to the Desktop folder, so a wrapper
       fails with "Operation not permitted" while the venv python, which is already
       granted, works. Two plists also keep the failures independent -- a Smartlead
       outage taking down the intake must not stop the watchdog, which is exactly when
       someone needs telling that nothing is running.

       On launchd because launchd is the only scheduler here PROVEN to survive an
       outage and come back: on 2026-09-21 the laptop was off all day, no heartbeat
       ran, and the intake job resumed by itself at 08:57 the next morning. The
       heartbeat cannot report its own silence; something that restarts itself must. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/alizamayer/Desktop/email-engine/outbound-engine/.venv/bin/python</string>
    <string>/Users/alizamayer/Desktop/email-engine/outbound-engine/scripts/heartbeat_watchdog.py</string>
    <string>--apply</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/alizamayer/Desktop/email-engine/outbound-engine</string>

  <!-- Every 15 minutes. The threshold is 5 BUSINESS hours, so checking more often buys
       nothing, and the script warns at most once per outage regardless. -->
  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/alizamayer/Desktop/email-engine/outbound-engine/logs/watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alizamayer/Desktop/email-engine/outbound-engine/logs/watchdog.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
